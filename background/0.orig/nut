FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{

    gateOverset
    {
        type overset;
        value uniform 0;
    }

    leftWall
    {
        type nutkWallFunction;
        value uniform 0;
    }

    bottomWall
    {
        type nutkWallFunction;
        value uniform 0;
    }

    outlet
    {
        type calculated;
        value uniform 0;
    }

    atmosphere
    {
        type calculated;
        value uniform 0;
    }

    gateBottom
    {
        type nutkWallFunction;
        value uniform 0;
    }

    gateUpstream
    {
        type nutkWallFunction;
        value uniform 0;
    }

    gateDownstream
    {
        type nutkWallFunction;
        value uniform 0;
    }

    gateTop
    {
        type nutkWallFunction;
        value uniform 0;
    }


    frontAndBack
    {
        type empty;
    }
}


