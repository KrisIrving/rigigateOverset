FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 10;

boundaryField
{
    oversetPatch
    {
        type overset;
        value uniform 10;
    }

    leftWall
    {
        type omegaWallFunction;
        value uniform 10;
    }

    bottomWall
    {
        type omegaWallFunction;
        value uniform 10;
    }

    outlet
    {
        type inletOutlet;
        inletValue uniform 10;
        value uniform 10;
    }

    atmosphere
    {
        type inletOutlet;
        inletValue uniform 10;
        value uniform 10;
    }

    gateBottom
    {
        type omegaWallFunction;
        value uniform 10;
    }

    gateUpstream
    {
        type omegaWallFunction;
        value uniform 10;
    }

    gateDownstream
    {
        type omegaWallFunction;
        value uniform 10;
    }

    gateTop
    {
        type omegaWallFunction;
        value uniform 10;
    }

    overset
    {
        type overset;
        value uniform 10;
    }

    frontAndBack
    {
        type empty;
    }
}


