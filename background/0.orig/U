FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    oversetPatch
    {
        type overset;
        value uniform (0 0 0);
    }

    leftWall
    {
        type noSlip;
    }

    bottomWall
    {
        type noSlip;
    }

    outlet
    {
        type pressureInletOutletVelocity;
        value uniform (0 0 0);
    }

    atmosphere
    {
        type pressureInletOutletVelocity;
        value uniform (0 0 0);
    }

    gateBottom
    {
        type movingWallVelocity;
        value uniform (0 0 0);
    }

    gateUpstream
    {
        type movingWallVelocity;
        value uniform (0 0 0);
    }

    gateDownstream
    {
        type movingWallVelocity;
        value uniform (0 0 0);
    }

    gateTop
    {
        type movingWallVelocity;
        value uniform (0 0 0);
    }

    overset
    {
        type overset;
        value uniform (0 0 0);
    }

    frontAndBack
    {
        type empty;
    }
}

