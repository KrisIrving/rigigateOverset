FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alpha.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;


boundaryField
{

    leftWall
    {
        type zeroGradient;
    }

    bottomWall
    {
        type zeroGradient;
    }

    outlet
    {
        type inletOutlet;
        inletValue uniform 0;
        value uniform 0;
    }

    atmosphere
    {
        type inletOutlet;
        inletValue uniform 0;
        value uniform 0;
    }

    gateBottom
    {
        type zeroGradient;
    }

    gateUpstream
    {
        type zeroGradient;
    }

    gateDownstream
    {
        type zeroGradient;
    }

    gateTop
    {
        type zeroGradient;
    }

    gateOverset
    {
        type overset;
        value uniform 0;
    }

    frontAndBack
    {
        type empty;
    }
}

// ************************************************************************* //
