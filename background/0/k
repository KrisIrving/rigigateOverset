FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 1e-4;

boundaryField
{

    leftWall
    {
        type kqRWallFunction;
        value uniform 1e-4;
    }

    bottomWall
    {
        type kqRWallFunction;
        value uniform 1e-4;
    }

    outlet
    {
        type inletOutlet;
        inletValue uniform 1e-4;
        value uniform 1e-4;
    }

    atmosphere
    {
        type inletOutlet;
        inletValue uniform 1e-4;
        value uniform 1e-4;
    }

    gateBottom
    {
        type kqRWallFunction;
        value uniform 1e-4;
    }

    gateUpstream
    {
        type kqRWallFunction;
        value uniform 1e-4;
    }

    gateDownstream
    {
        type kqRWallFunction;
        value uniform 1e-4;
    }

    gateTop
    {
        type kqRWallFunction;
        value uniform 1e-4;
    }

    gateOverset
    {
        type overset;
        value uniform 1e-4;
    }

    frontAndBack
    {
        type empty;
    }
}

