FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue alpha.water 0
    volScalarFieldValue zoneID 123
);

regions
(
    // Initial water reservoir
    boxToCell
    {
        box (0 0 -0.001) (1.20 0.40 0.011);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
        );
    }

    // Background mesh zoneID = 0
    cellToCell
    {
        set c0;
        fieldValues
        (
            volScalarFieldValue zoneID 0
        );
    }

    // Moving gate overset mesh zoneID = 1
    cellToCell
    {
        set c1;
        fieldValues
        (
            volScalarFieldValue zoneID 1
        );
    }
);

