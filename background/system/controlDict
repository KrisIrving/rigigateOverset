FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

libs
(
    overset
    fvMotionSolvers
    sampling
    fieldFunctionObjects
    forces
);

application     overInterDyMFoam;

startFrom       latestTime;
startTime       0.0;

stopAt          endTime;
endTime         1;

deltaT          1e-6;

writeControl    adjustable;
writeInterval   0.02;

purgeWrite      0;

writeFormat     ascii;
writePrecision  12;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  yes;
maxCo           0.2;
maxAlphaCo      0.2;
maxDeltaT       1e-4;

